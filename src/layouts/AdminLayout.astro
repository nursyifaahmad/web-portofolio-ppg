---
import { isAdminAuthenticated } from '../lib/auth';
import '../styles/global.css';

export const prerender = false;

const isAuth = isAdminAuthenticated(Astro.cookies);
if (!isAuth) {
  return Astro.redirect('/admin/login');
}

interface Props {
  title?: string;
  activeTab?: 'galeri' | 'inovasi' | 'backup';
}

const { title = "Portal Admin E-Portofolio PPG", activeTab = "galeri" } = Astro.props;
---

<!doctype html>
<html lang="id" class="dark">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/png" href="/AN Logo.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Ahmad Nursyifa, S.Kom.</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
      body {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      }
      code, pre, .font-mono-tech {
        font-family: 'Fira Code', monospace;
      }
    </style>
  </head>
  <body class="min-h-screen bg-[#080d1a] text-slate-100 flex flex-col antialiased">
    
    <!-- Top Navigation Bar -->
    <header class="sticky top-0 z-40 bg-slate-950/90 backdrop-blur-md border-b border-cyan-500/20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16 sm:h-20">
          
          <!-- Brand -->
          <div class="flex items-center gap-3">
            <a href="/admin" class="flex items-center gap-3 group focus:outline-none">
              <div class="w-10 h-10 rounded-xl bg-white p-1 flex items-center justify-center shadow-lg shadow-cyan-500/25 border border-cyan-400/40 overflow-hidden shrink-0 group-hover:scale-105 transition-transform">
                <img src="/AN Logo.png" alt="AN Logo" class="w-full h-full object-contain rounded-lg" />
              </div>
              <div class="flex flex-col">
                <div class="flex items-center gap-2">
                  <span class="font-bold text-base sm:text-lg text-white group-hover:text-cyan-400 transition-colors">
                    Portal Admin
                  </span>
                  <span class="text-[10px] px-2 py-0.5 rounded-full bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 font-mono-tech font-bold uppercase">
                    CMS CRUD
                  </span>
                </div>
                <span class="text-xs text-slate-400 font-mono-tech flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                  E-Portofolio PPG Prajabatan
                </span>
              </div>
            </a>
          </div>

          <!-- Navigation Links & Actions -->
          <div class="flex items-center gap-3 sm:gap-4">
            <a
              href="/"
              target="_blank"
              class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-slate-700 bg-slate-900/80 hover:bg-slate-800 text-slate-300 hover:text-cyan-300 font-mono-tech text-xs transition-all"
            >
              <span>🌐 Lihat Web</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
              </svg>
            </a>

            <div class="h-6 w-px bg-slate-800 hidden sm:block"></div>

            <div class="flex items-center gap-2">
              <span class="text-xs font-mono-tech text-slate-400 hidden md:inline">
                👤 Ahmad Nursyifa
              </span>
              <button
                id="logout-btn"
                type="button"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 text-rose-300 border border-rose-500/30 font-mono-tech text-xs font-semibold transition-all cursor-pointer"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                </svg>
                <span>Keluar</span>
              </button>
            </div>
          </div>

        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-800/80 bg-slate-950/60 py-6 text-center text-xs font-mono-tech text-slate-500">
      <p>© 2026 E-Portofolio PPG Ahmad Nursyifa, S.Kom. • Universitas Pendidikan Indonesia</p>
    </footer>

    <!-- Toast Notification Container -->
    <div id="toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <script is:inline>
      // Global toast notification helper
      window.showToast = function(message, type = 'success') {
        const container = document.getElementById('toast-container');
        if (!container) return;

        const toast = document.createElement('div');
        toast.className = `px-4 py-3 rounded-xl border font-mono-tech text-xs font-semibold shadow-2xl flex items-center gap-2 transform transition-all duration-300 translate-y-4 opacity-0 pointer-events-auto ${
          type === 'success'
            ? 'bg-emerald-950/90 border-emerald-500/40 text-emerald-200'
            : 'bg-rose-950/90 border-rose-500/40 text-rose-200'
        }`;
        
        toast.innerHTML = `
          <span>${type === 'success' ? '✅' : '❌'}</span>
          <span>${message}</span>
        `;

        container.appendChild(toast);

        // Animate in
        requestAnimationFrame(() => {
          toast.classList.remove('translate-y-4', 'opacity-0');
        });

        // Auto remove
        setTimeout(() => {
          toast.classList.add('opacity-0', 'translate-x-4');
          setTimeout(() => toast.remove(), 300);
        }, 4000);
      };

      // Handle logout
      document.getElementById('logout-btn')?.addEventListener('click', async () => {
        if (!confirm('Apakah Anda yakin ingin keluar dari Portal Admin?')) return;
        try {
          await fetch('/api/admin/logout', { method: 'POST' });
          window.location.href = '/admin/login';
        } catch {
          window.location.href = '/admin/login';
        }
      });
    </script>
  </body>
</html>
