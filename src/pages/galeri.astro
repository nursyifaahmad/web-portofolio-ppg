---
import Layout from '../layouts/Layout.astro';
import ArtifactViewerModal from '../components/ArtifactViewerModal.astro';
import galeri from '../data/galeri.json';
import profil from '../data/profil.json';

const immichAlbumUrl = "https://foto.ahmadnursyifa.my.id/share/kr8hiiBZLT426D9lx8L0ukouIzPXhT8hAHvNJkst-TlxNSA7sJwtJS_CKxSFtzLBc78";
---

<Layout
  title={`Galeri Dokumentasi & Praktik Lapangan — ${profil.nama}, ${profil.gelar}`}
  description="Dokumentasi Visual Praktik Pembelajaran Mandiri SMAN 15 Bandung, Pembelajaran Algoritma Kelas X-5, Gelar Karya SIDAKAN IoT, dan Bimbingan Guru Pamong."
>
  <div class="py-8 sm:py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto">
      <div class="tech-badge mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
        Dokumentasi Empiris & Praktik Nyata
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight">
        Galeri Praktik Mengajar & Kegiatan PPL
      </h1>
      <p class="text-sm sm:text-base text-slate-300 mt-4 leading-relaxed">
        Rekaman visual aktivitas belajar mengajar di laboratorium komputer dan ruang kelas <strong>SMAN 15 Bandung</strong>, implementasi model Problem-Based Learning (PBL) berbasis AlgoCraft di kelas X-5, demonstrasi inovasi IoT SIDAKAN, serta bimbingan intensif bersama Guru Pamong <strong>Andre Dewantara, S.T., Gr.</strong>
      </p>
    </div>

    <!-- Live Cloud Immich Album Banner -->
    <div class="tech-card p-6 sm:p-8 bg-gradient-to-r from-slate-900/90 via-cyan-950/40 to-slate-900/90 border border-cyan-500/30 relative overflow-hidden flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-2">
        <div class="flex items-center gap-2">
          <span class="px-2.5 py-0.5 rounded-full text-xs font-mono-tech text-cyan-300 bg-cyan-500/20 border border-cyan-500/30 font-bold">
            ☁️ Immich Photo Cloud Self-Hosted
          </span>
          <span class="text-xs font-mono-tech text-slate-400">172+ Foto Asli Resolusi Penuh</span>
        </div>
        <h3 class="text-lg sm:text-xl font-bold text-white">
          Album Foto Lengkap & Tidak Terkompresi
        </h3>
        <p class="text-xs sm:text-sm text-slate-300 max-w-2xl leading-relaxed">
          Seluruh dokumentasi kegiatan PPG, microteaching, asistensi mengajar, hingga gelar karya tersimpan aman di server penyimpanan foto mandiri (Immich Cloud Ahmad Nursyifa).
        </p>
      </div>

      <a
        href={immichAlbumUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold text-xs sm:text-sm font-mono-tech shadow-lg shadow-cyan-500/25 transition-all shrink-0 cursor-pointer"
      >
        <span>Buka Album Immich (172 Foto)</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
        </svg>
      </a>
    </div>

    <!-- Filter Buttons -->
    <div class="flex flex-wrap items-center justify-center gap-2">
      <button class="gallery-filter-btn px-4 py-2 rounded-xl text-xs font-semibold font-mono-tech transition-all bg-cyan-500 text-slate-950 font-bold shadow-md cursor-pointer" data-filter="all">
        Semua Koleksi ({galeri.length})
      </button>
      <button class="gallery-filter-btn px-4 py-2 rounded-xl text-xs font-semibold font-mono-tech transition-all bg-slate-900 border border-slate-800 text-slate-300 hover:text-white hover:border-cyan-500/40 cursor-pointer" data-filter="ppl-2">
        PPL II SMAN 15 Bandung ({galeri.filter(g => g.kategori === 'ppl-2').length})
      </button>
      <button class="gallery-filter-btn px-4 py-2 rounded-xl text-xs font-semibold font-mono-tech transition-all bg-slate-900 border border-slate-800 text-slate-300 hover:text-white hover:border-cyan-500/40 cursor-pointer" data-filter="sidakan">
        Projek Kepemimpinan SIDAKAN ({galeri.filter(g => g.kategori === 'sidakan').length})
      </button>
    </div>

    <!-- Gallery Grid -->
    <div id="gallery-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
      {galeri.map(foto => (
        <div
          class="gallery-item tech-card overflow-hidden group cursor-pointer flex flex-col hover:border-cyan-500/40 transition-all"
          data-category={foto.kategori}
          data-url={foto.url}
          data-title={foto.judul}
          data-meta={`${foto.lokasi} • ${foto.tanggal}`}
        >
          <!-- Image Container with aspect ratio -->
          <div class="relative aspect-4/3 overflow-hidden bg-slate-950">
            <img
              src={foto.url}
              alt={foto.judul}
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-3">
              <span class="text-[11px] font-mono-tech text-cyan-300 font-semibold flex items-center gap-1">
                🔍 Klik untuk memperbesar
              </span>
            </div>
            <span class="absolute top-2 left-2 text-[10px] font-mono-tech font-bold uppercase px-2 py-0.5 rounded bg-slate-950/80 backdrop-blur-md border border-cyan-500/30 text-cyan-300">
              {foto.kategori === 'ppl-2' ? 'PPL II SMAN 15' : 'SIDAKAN IoT'}
            </span>
          </div>

          <!-- Caption & Info -->
          <div class="p-4 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="text-sm font-bold text-white group-hover:text-cyan-300 transition-colors line-clamp-1">
                {foto.judul}
              </h3>
              <p class="text-xs text-slate-400 mt-1 line-clamp-2 leading-relaxed">
                {foto.deskripsi}
              </p>
            </div>

            <div class="mt-3 pt-2 border-t border-slate-800/80 flex items-center justify-between text-[10px] font-mono-tech text-slate-500">
              <span class="truncate pr-2">📍 {foto.lokasi}</span>
              <span class="shrink-0">{foto.tanggal}</span>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>

  <ArtifactViewerModal />
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Filter functionality
    const filterBtns = document.querySelectorAll('.gallery-filter-btn');
    const items = document.querySelectorAll('.gallery-item');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        // Update active button styling
        filterBtns.forEach(b => {
          b.className = 'gallery-filter-btn px-4 py-2 rounded-xl text-xs font-semibold font-mono-tech transition-all bg-slate-900 border border-slate-800 text-slate-300 hover:text-white cursor-pointer';
        });
        btn.className = 'gallery-filter-btn px-4 py-2 rounded-xl text-xs font-semibold font-mono-tech transition-all bg-cyan-500 text-slate-950 font-bold shadow-md cursor-pointer';

        // Filter items
        items.forEach(item => {
          const cat = item.getAttribute('data-category');
          if (filter === 'all' || cat === filter) {
            item.classList.remove('hidden');
          } else {
            item.classList.add('hidden');
          }
        });
      });
    });

    // Click on photo opens global modal viewer
    items.forEach(item => {
      item.addEventListener('click', () => {
        const url = item.getAttribute('data-url');
        const title = item.getAttribute('data-title');
        const meta = item.getAttribute('data-meta');

        window.dispatchEvent(new CustomEvent('open-artifact', {
          detail: {
            url,
            title,
            type: 'image',
            meta
          }
        }));
      });
    });
  });
</script>
