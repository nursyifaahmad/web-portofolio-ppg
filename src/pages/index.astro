---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Timeline from '../components/Timeline.astro';
import profil from '../data/profil.json';
---

<Layout
  title={`${profil.nama}, ${profil.gelar} — E-Portofolio PPG Prajabatan UPI 2026`}
  description={`E-Portofolio Interaktif Perkuliahan PPG Prajabatan Informatika UPI 2026. Lengkap dengan 427+ artefak, LK, modul ajar, dan refleksi 4F.`}
>
  <!-- Hero Section -->
  <Hero />

  <!-- Animated Timeline Section -->
  <Timeline />

  <!-- Quick CTA Banner to Gallery & Terminal -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="tech-card p-8 sm:p-12 relative overflow-hidden bg-gradient-to-br from-slate-900 via-slate-950 to-cyan-950/50 border border-cyan-500/30 text-center">
      <div class="max-w-2xl mx-auto space-y-4">
        <span class="tech-badge">
          Dokumentasi Visual & Interaktif
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold text-white">
          Lihat Dokumentasi Pembelajaran Nyata & Uji CLI
        </h2>
        <p class="text-sm text-slate-300 leading-relaxed">
          Eksplorasi galeri foto pengajaran di SMAN 15 Bandung, microteaching, atau buka terminal interaktif dengan shortcut <kbd class="px-2 py-0.5 rounded bg-slate-800 text-cyan-400 font-mono-tech border border-cyan-500/20 text-xs">Ctrl+K</kbd> / <kbd class="px-2 py-0.5 rounded bg-slate-800 text-cyan-400 font-mono-tech border border-cyan-500/20 text-xs">`</kbd>.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
          <a
            href="/galeri"
            class="px-6 py-3 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-bold text-sm shadow-lg shadow-cyan-500/20 transition-all"
          >
            Buka Galeri Foto PPL
          </a>
          <button
            onclick="window.dispatchEvent(new CustomEvent('open-terminal'))"
            class="px-6 py-3 rounded-xl border border-cyan-500/40 bg-slate-900/80 hover:bg-slate-800 text-cyan-300 font-mono-tech font-bold text-sm cursor-pointer transition-all"
          >
            &gt;_ Jalankan Terminal CLI
          </button>
        </div>
      </div>
    </div>
  </section>
</Layout>
