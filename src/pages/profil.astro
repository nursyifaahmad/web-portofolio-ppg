---
import Layout from '../layouts/Layout.astro';
import profil from '../data/profil.json';
---

<Layout
  title={`Profil & Visi Pendidik — ${profil.nama}, ${profil.gelar}`}
  description={`Profil lengkap, identifikasi diri, visi hidup TAAT, dan visi pendidik informatika PANDAI Ahmad Nursyifa, PPG Prajabatan UPI 2026.`}
>
  <div class="py-8 sm:py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs font-mono-tech text-slate-400 mb-8">
      <a href="/" class="hover:text-cyan-400">Beranda</a>
      <span>/</span>
      <span class="text-cyan-400">Profil & Visi Pendidik</span>
    </nav>

    <!-- Header Section with Photo & Bio -->
    <div class="tech-card p-6 sm:p-10 mb-12 relative overflow-hidden">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
        <!-- Photo -->
        <div class="md:col-span-4 flex justify-center">
          <div class="relative group">
            <div class="absolute -inset-1 rounded-2xl bg-gradient-to-r from-cyan-500 to-blue-600 opacity-75 blur-md"></div>
            <img
              src={profil.foto}
              alt={profil.nama}
              class="relative w-48 h-64 object-cover rounded-2xl border-2 border-cyan-400 shadow-2xl"
            />
          </div>
        </div>

        <!-- Info -->
        <div class="md:col-span-8 space-y-4">
          <div class="flex flex-wrap items-center gap-2">
            <span class="tech-badge">Profil Calon Guru Profesional</span>
            <span class="text-xs font-mono-tech px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
              UPI Bandung
            </span>
          </div>

          <h1 class="text-3xl sm:text-4xl font-extrabold text-white">
            {profil.nama}, {profil.gelar}
          </h1>

          <p class="text-sm sm:text-base text-slate-300 leading-relaxed font-sans">
            Mahasiswa Program Pendidikan Profesi Guru (PPG) Prajabatan Gelombang 1 Tahun 2026 Bidang Studi Informatika di Universitas Pendidikan Indonesia (UPI). Berpengalaman mengajar di sekolah mitra <strong>{profil.sekolahPPL}</strong> di bawah bimbingan Guru Pamong <strong>{profil.guruPamong}</strong> dan Dosen Pembimbing Lapangan <strong>{profil.dosenPembimbing}</strong>.
          </p>

          <!-- Quick Specs Grid -->
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-2 text-xs font-mono-tech">
            <div class="p-3 rounded-xl bg-slate-900/80 border border-slate-800">
              <span class="text-slate-500 block text-[10px]">NIM</span>
              <span class="text-cyan-400 font-bold">{profil.nim}</span>
            </div>
            <div class="p-3 rounded-xl bg-slate-900/80 border border-slate-800">
              <span class="text-slate-500 block text-[10px]">Bidang Studi</span>
              <span class="text-white font-medium">{profil.bidangStudi} ({profil.kelas})</span>
            </div>
            <div class="p-3 rounded-xl bg-slate-900/80 border border-slate-800">
              <span class="text-slate-500 block text-[10px]">Sekolah Praktik</span>
              <span class="text-white font-medium">{profil.sekolahPPL}</span>
            </div>
          </div>


        </div>
      </div>
    </div>

    <!-- Visi Pendidikan Indonesia -->
    <div class="tech-card p-6 sm:p-8 mb-12 border-l-4 border-l-cyan-400 bg-slate-950/60">
      <span class="text-xs font-mono-tech uppercase font-bold text-cyan-400 tracking-wider">
        Visi Pribadi untuk Pendidikan Indonesia
      </span>
      <blockquote class="mt-2 text-base sm:text-xl font-medium text-white italic leading-relaxed">
        &ldquo;{profil.visiPendidikan}&rdquo;
      </blockquote>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-6 text-xs text-slate-300">
        <div class="p-3 rounded-lg bg-slate-900/60 border border-slate-800">
          <strong class="text-cyan-300 block mb-1">Humanis</strong>
          Pembelajaran menghargai harkat martabat dan kodrat alamiah serta kodrat zaman setiap peserta didik.
        </div>
        <div class="p-3 rounded-lg bg-slate-900/60 border border-slate-800">
          <strong class="text-emerald-300 block mb-1">Inklusif</strong>
          Ruang belajar yang aman dan ramah bagi semua ragam peserta didik tanpa diskriminasi kemampuan.
        </div>
        <div class="p-3 rounded-lg bg-slate-900/60 border border-slate-800">
          <strong class="text-purple-300 block mb-1">Berbasis Teknologi</strong>
          Informatika menjadi instrumen pemberdayaan berpikir kritis, kreatif, dan pemecahan masalah nyata.
        </div>
      </div>
    </div>

    <!-- Visi Calon Guru: PANDAI -->
    <div class="mb-12">
      <div class="mb-6">
        <div class="tech-badge mb-2">Visi Calon Guru Informatika</div>
        <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
          Profil Karakter & Kompetensi Murid: &ldquo;{profil.visiGuru.akronim}&rdquo;
        </h2>
        <p class="text-xs sm:text-sm text-slate-400 mt-1 max-w-2xl">
          {profil.visiGuru.definisi}
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
        {profil.visiGuru.pilar.map(p => (
          <div class="tech-card p-5 relative overflow-hidden group hover:border-cyan-400/50 transition-all">
            <div class="flex items-center gap-3 mb-2">
              <span class="w-10 h-10 rounded-xl bg-gradient-to-br from-cyan-500/20 to-blue-600/20 border border-cyan-500/40 text-cyan-300 font-mono-tech font-extrabold text-lg flex items-center justify-center">
                {p.huruf}
              </span>
              <div>
                <h3 class="text-base font-bold text-white group-hover:text-cyan-300 transition-colors">
                  {p.kata}
                </h3>
                <span class="text-[10px] font-mono-tech text-slate-500">Pilar {p.huruf}</span>
              </div>
            </div>
            <p class="text-xs sm:text-sm text-slate-300 mt-2 leading-relaxed">
              {p.deskripsi}
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- Visi Hidup: TAAT -->
    <div class="mb-12">
      <div class="mb-6">
        <div class="tech-badge mb-2">Fondasi Pribadi</div>
        <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
          Visi Menjalani Hidup: &ldquo;{profil.visiHidup.akronim}&rdquo;
        </h2>
        <p class="text-xs sm:text-sm text-slate-400 mt-1 max-w-2xl">
          Nilai personal spiritual dan moral yang memperkokoh integritas sebagai seorang pendidik masa depan.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {profil.visiHidup.pilar.map(p => (
          <div class="p-5 rounded-2xl bg-slate-900/60 border border-amber-500/20 hover:border-amber-500/50 transition-all">
            <span class="w-8 h-8 rounded-lg bg-amber-500/10 border border-amber-500/30 text-amber-300 font-mono-tech font-bold text-sm flex items-center justify-center mb-3">
              {p.huruf}
            </span>
            <h3 class="text-base font-bold text-white mb-1">{p.kata}</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              {p.deskripsi}
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- Mentors Section -->
    <div class="tech-card p-6 sm:p-8">
      <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
        <span>👨‍🏫</span>
        <span>Pembimbing & Penguji Lapangan</span>
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm">
        <div class="p-4 rounded-xl bg-slate-950/80 border border-slate-800">
          <span class="text-xs font-mono-tech text-cyan-400 uppercase font-semibold block mb-1">Guru Pamong SMAN 15 Bandung</span>
          <h4 class="text-base font-bold text-white">{profil.guruPamong}</h4>
          <p class="text-xs text-slate-400 mt-1">
            Membimbing pelaksanaan praktik mengajar, penyusunan RPP/Modul Ajar, penanganan kelas X & XI, serta refleksi mingguan di SMAN 15 Bandung.
          </p>
        </div>

        <div class="p-4 rounded-xl bg-slate-950/80 border border-slate-800">
          <span class="text-xs font-mono-tech text-emerald-400 uppercase font-semibold block mb-1">Dosen Pembimbing Lapangan (DPL)</span>
          <h4 class="text-base font-bold text-white">{profil.dosenPembimbing}</h4>
          <p class="text-xs text-slate-400 mt-1">
            Dosen Pembimbing Lapangan Universitas Pendidikan Indonesia yang mengawal ketepatan pedagogis, integrasi PCK Informatika, dan penilaian e-portofolio.
          </p>
        </div>
      </div>
    </div>

  </div>
</Layout>
