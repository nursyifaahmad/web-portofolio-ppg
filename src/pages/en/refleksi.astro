---
import Layout from '../../layouts/Layout.astro';
import ReflectionViewer from '../../components/ReflectionViewer.astro';
import courses from '../../data/course-details.json';
import profil from '../../data/profil.json';

const coursesWithReflection = courses.filter(
  c => c.refleksi4C && (c.refleksi4C.connection || c.refleksi4C.rumusan_refleksi)
);

const sem1Reflections = coursesWithReflection.filter(c => c.semester === 'sem1');
const sem2Reflections = coursesWithReflection.filter(c => c.semester === 'sem2');
---

<Layout
  title={`4C Critical Reflection — ${profil.nama}, ${profil.gelar}`}
  description="Deep Reflection Using the 4C Model (Connection, Challenge, Concept, Change) from Official Worksheets (LK 2) across 12 Courses of PPG Prajabatan Informatics UPI 2026."
  isEn={true}
>
  <div class="py-12 sm:py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">

    <!-- Page Header -->
    <div class="text-center max-w-3xl mx-auto">
      <div class="tech-badge mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
        Metacognitive Journal & Self-Evaluation
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight">
        Critical Learning Reflection (4C Model)
      </h1>
      <p class="text-sm sm:text-base text-slate-300 mt-4 leading-relaxed">
        A comprehensive synthesis of professional teacher transformation directly synthesized from authentic Worksheets (LK 2) of PPG Prajabatan Informatics UPI 2026. Exploring connections with prior experience, paradigm challenges, mastery of key concepts, and actionable classroom change.
      </p>
    </div>

    <!-- 4C Framework Overview -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="tech-card p-5 border-l-4 border-l-cyan-400 bg-slate-900/60">
        <div class="flex items-center gap-2 mb-2">
          <span class="text-xl">🔗</span>
          <span class="text-xs font-mono-tech uppercase font-bold text-cyan-300">1. Connection</span>
        </div>
        <h4 class="text-white font-bold text-sm mb-1">Teacher Role Alignment</h4>
        <p class="text-xs text-slate-400 leading-relaxed">
          Connecting course insights with professional roles, responsibilities, and pedagogical ethics in the AI era.
        </p>
      </div>

      <div class="tech-card p-5 border-l-4 border-l-amber-400 bg-slate-900/60">
        <div class="flex items-center gap-2 mb-2">
          <span class="text-xl">⚡</span>
          <span class="text-xs font-mono-tech uppercase font-bold text-amber-300">2. Challenge</span>
        </div>
        <h4 class="text-white font-bold text-sm mb-1">Paradigm Shift</h4>
        <p class="text-xs text-slate-400 leading-relaxed">
          Challenging conventional assumptions toward student-centered, differentiated, and empathetic instruction.
        </p>
      </div>

      <div class="tech-card p-5 border-l-4 border-l-emerald-400 bg-slate-900/60">
        <div class="flex items-center gap-2 mb-2">
          <span class="text-xl">💡</span>
          <span class="text-xs font-mono-tech uppercase font-bold text-emerald-300">3. Concept</span>
        </div>
        <h4 class="text-white font-bold text-sm mb-1">Pedagogical Mastery</h4>
        <p class="text-xs text-slate-400 leading-relaxed">
          Mastering core theories: KHD Philosophy, TaRL, Differentiation, CASEL SEL, UDL, and TPACK frameworks.
        </p>
      </div>

      <div class="tech-card p-5 border-l-4 border-l-purple-400 bg-slate-900/60">
        <div class="flex items-center gap-2 mb-2">
          <span class="text-xl">🚀</span>
          <span class="text-xs font-mono-tech uppercase font-bold text-purple-300">4. Change</span>
        </div>
        <h4 class="text-white font-bold text-sm mb-1">Actionable Practice</h4>
        <p class="text-xs text-slate-400 leading-relaxed">
          Concrete steps in lesson redesign, authentic rubrics, peer collaboration, and inclusive classroom delivery.
        </p>
      </div>
    </div>

    <!-- Quick Filter Navigation -->
    <div class="flex flex-wrap items-center justify-between gap-4 p-4 rounded-2xl bg-slate-900/80 border border-slate-800">
      <div class="flex items-center gap-2">
        <span class="text-xs font-mono-tech text-slate-400 uppercase tracking-wider font-semibold">Quick Jump:</span>
        <a href="#semester-1" class="text-xs font-mono-tech px-3 py-1.5 rounded-lg bg-cyan-950/70 border border-cyan-500/30 text-cyan-300 hover:bg-cyan-900/50 transition-colors">
          Semester 1 ({sem1Reflections.length} Courses)
        </a>
        <a href="#semester-2" class="text-xs font-mono-tech px-3 py-1.5 rounded-lg bg-purple-950/70 border border-purple-500/30 text-purple-300 hover:bg-purple-900/50 transition-colors">
          Semester 2 ({sem2Reflections.length} Courses)
        </a>
      </div>
      <span class="text-xs text-slate-400 font-mono-tech">
        Total: {coursesWithReflection.length} Authentic Reflection Journals
      </span>
    </div>

    <!-- SEMESTER 1 SECTION -->
    <section id="semester-1" class="space-y-10 pt-4">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 pb-4 border-b border-slate-800">
        <div>
          <div class="tech-badge mb-1">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
            Semester 1
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
            Semester 1: Philosophical Foundations & Teaching Principles
          </h2>
        </div>
        <span class="text-xs font-mono-tech text-cyan-400 bg-cyan-950/60 px-3 py-1 rounded-full border border-cyan-500/30">
          6 Core Courses
        </span>
      </div>

      <div class="space-y-12">
        {sem1Reflections.map((course) => (
          <div id={course.id} class="scroll-mt-24 space-y-4">
            <!-- Header Card Mata Kuliah -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-5 rounded-2xl bg-slate-900/70 border border-slate-800">
              <div class="flex items-center gap-3">
                <span class="w-3 h-3 rounded-full" style={`background: ${course.accent}`}></span>
                <div>
                  <div class="flex items-center gap-2">
                    <span class="text-xs font-mono-tech text-slate-400 font-bold">{course.kode}</span>
                    <span class="text-xs font-mono-tech text-cyan-400">{course.sks} SKS</span>
                  </div>
                  <h3 class="text-lg sm:text-xl font-bold text-white mt-0.5">
                    {course.titleEn || course.title}
                  </h3>
                </div>
              </div>

              <div class="flex items-center gap-2 self-start sm:self-auto flex-wrap">
                {course.refleksi4C?.docx_url && (
                  <a
                    href={course.refleksi4C.docx_url}
                    download
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 text-xs font-mono-tech font-semibold transition-all shadow-sm"
                  >
                    <span>📄</span>
                    <span>Download Worksheet (.docx)</span>
                  </a>
                )}
                <a
                  href={`/en/matkul/${course.id}`}
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-cyan-600/20 hover:bg-cyan-600/30 border border-cyan-500/40 text-cyan-300 text-xs font-semibold transition-all"
                >
                  <span>Explore Artifacts ({course.totalArtefakCount || course.topikCount * 3}+ Files)</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </a>
              </div>
            </div>

            <!-- Komponen Refleksi 4C & Analisis Artefak -->
            <ReflectionViewer
              refleksi={course.refleksi}
              refleksi4C={course.refleksi4C}
              courseTitle={course.titleEn || course.title}
              docUrl={course.refleksi4C?.docx_url}
              isEn={true}
            />
          </div>
        ))}
      </div>
    </section>

    <!-- SEMESTER 2 SECTION -->
    <section id="semester-2" class="space-y-10 pt-8 border-t border-slate-800">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 pb-4 border-b border-slate-800">
        <div>
          <div class="tech-badge mb-1">
            <span class="w-1.5 h-1.5 rounded-full bg-purple-400"></span>
            Semester 2
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
            Semester 2: Field Practice, Innovation & PPL II Culmination
          </h2>
        </div>
        <span class="text-xs font-mono-tech text-purple-400 bg-purple-950/60 px-3 py-1 rounded-full border border-purple-500/30">
          7 Core Courses
        </span>
      </div>

      <div class="space-y-12">
        {sem2Reflections.map((course) => (
          <div id={course.id} class="scroll-mt-24 space-y-4">
            <!-- Header Card Mata Kuliah -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-5 rounded-2xl bg-slate-900/70 border border-slate-800">
              <div class="flex items-center gap-3">
                <span class="w-3 h-3 rounded-full" style={`background: ${course.accent}`}></span>
                <div>
                  <div class="flex items-center gap-2">
                    <span class="text-xs font-mono-tech text-slate-400 font-bold">{course.kode}</span>
                    <span class="text-xs font-mono-tech text-purple-400">{course.sks} SKS</span>
                  </div>
                  <h3 class="text-lg sm:text-xl font-bold text-white mt-0.5">
                    {course.titleEn || course.title}
                  </h3>
                </div>
              </div>

              <div class="flex items-center gap-2 self-start sm:self-auto flex-wrap">
                {course.refleksi4C?.docx_url && (
                  <a
                    href={course.refleksi4C.docx_url}
                    download
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 text-xs font-mono-tech font-semibold transition-all shadow-sm"
                  >
                    <span>📄</span>
                    <span>Download Worksheet (.docx)</span>
                  </a>
                )}
                <a
                  href={`/en/matkul/${course.id}`}
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-purple-600/20 hover:bg-purple-600/30 border border-purple-500/40 text-purple-300 text-xs font-semibold transition-all"
                >
                  <span>Explore Artifacts ({course.totalArtefakCount || course.topikCount * 3}+ Files)</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </a>
              </div>
            </div>

            <!-- Komponen Refleksi 4C & Analisis Artefak -->
            <ReflectionViewer
              refleksi={course.refleksi}
              refleksi4C={course.refleksi4C}
              courseTitle={course.titleEn || course.title}
              docUrl={course.refleksi4C?.docx_url}
              isEn={true}
            />
          </div>
        ))}
      </div>
    </section>

  </div>
</Layout>
