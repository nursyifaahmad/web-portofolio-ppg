---
import Layout from '../../layouts/Layout.astro';
import ArtifactViewerModal from '../../components/ArtifactViewerModal.astro';
import inovasiList from '../../data/inovasi.json';
import profil from '../../data/profil.json';
import lk4 from '../../data/seminar-lk4.json';

const algocraft = inovasiList.find(i => i.id === 'algocraft');
const otherInovasi = inovasiList.filter(i => i.id !== 'algocraft');
---

<Layout
  title={`Learning Innovation & LK 4 Design — ${profil.nama}, ${profil.gelar}`}
  description="Educational Innovations, AlgoCraft Web Gamified Platform, Innovative Design Formulation (LK 4), SIDAKAN IoT Smart Farming, and Classroom Action Research (CAR) at SMAN 15 Bandung."
  isEn={true}
>
  <div class="py-8 sm:py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">

    <!-- Page Header -->
    <div class="text-center max-w-3xl mx-auto">
      <div class="tech-badge mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
        Featured Works & Educational Technology
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight">
        Learning Innovations & Tech Works
      </h1>
      <p class="text-sm sm:text-base text-slate-300 mt-4 leading-relaxed">
        Integrating modern Problem-Based Learning (PBL) pedagogy, software engineering, and the Internet of Things (IoT) to resolve real-world secondary school Informatics learning hurdles and community service needs.
      </p>
    </div>

    <!-- FEATURED HERO: ALGOCRAFT -->
    {algocraft && (
      <section class="tech-card p-6 sm:p-10 relative overflow-hidden border border-cyan-500/40 bg-gradient-to-br from-slate-900/90 via-slate-950/90 to-cyan-950/20 shadow-2xl">
        <div class="absolute top-0 right-0 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none -mr-20 -mt-20"></div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
          
          <!-- Column Description -->
          <div class="lg:col-span-7 space-y-5">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="px-3 py-1 rounded-full text-xs font-mono-tech font-bold bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 whitespace-nowrap">
                ⭐ {algocraft.highlightEn || algocraft.highlight}
              </span>
              <span class="px-2.5 py-0.5 rounded-full text-xs font-mono-tech text-emerald-400 bg-emerald-950/80 border border-emerald-500/30 flex items-center gap-1.5 whitespace-nowrap">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                {algocraft.status}
              </span>
            </div>

            <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-white tracking-tight leading-tight">
              {algocraft.titleEn || algocraft.title}
            </h2>

            <p class="text-sm sm:text-base text-slate-300 leading-relaxed text-justify">
              {algocraft.deskripsiEn || algocraft.deskripsi}
            </p>

            <!-- Stats Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 py-2">
              {(algocraft.statsEn || algocraft.stats).map(s => (
                <div class="p-3 rounded-xl bg-slate-950/80 border border-slate-800">
                  <span class="text-[10px] font-mono-tech uppercase text-slate-400 block">{s.label}</span>
                  <span class="text-xs sm:text-sm font-bold text-cyan-300 block truncate mt-0.5">{s.value}</span>
                </div>
              ))}
            </div>

            <!-- Tech Tags -->
            <div class="flex flex-wrap gap-1.5 pt-1">
              {algocraft.techStack.map(t => (
                <span class="px-2.5 py-1 rounded-md text-xs font-mono-tech bg-slate-900 border border-slate-800 text-slate-300">
                  {t}
                </span>
              ))}
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-wrap items-center gap-3 pt-3">
              <a
                href={algocraft.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-slate-950 font-bold text-xs sm:text-sm font-mono-tech shadow-lg shadow-cyan-500/25 transition-all transform hover:-translate-y-0.5"
              >
                <span>🚀 Visit Live Platform</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                </svg>
              </a>

              <a
                href="#dossier-lk4"
                class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-amber-500/20 border border-amber-500/40 text-amber-300 font-mono-tech text-xs font-bold hover:bg-amber-500/30 transition-all"
              >
                <span>📑 Innovation Design Dossier (LK 4)</span>
              </a>

              <a
                href="/Artefak PPG/05_Semester_2/05_PPL_2_Mandiri_SMAN_15_Bandung/02_Penelitian_Tindakan_Kelas_PTK/LKPD_PBL_Siklus_I_Berpikir_Algoritmik_X5.pdf"
                target="_blank"
                class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-700 hover:border-cyan-500/40 text-slate-200 hover:text-cyan-300 font-mono-tech text-xs font-semibold transition-all"
              >
                <span>📄 Algorithmic Thinking LKPD</span>
              </a>
            </div>
          </div>

          <!-- Column Visual Preview -->
          <div class="lg:col-span-5">
            <div class="relative group rounded-2xl overflow-hidden border border-cyan-500/30 bg-slate-950 shadow-2xl">
              <img
                src={algocraft.image}
                alt={algocraft.titleEn || algocraft.title}
                class="w-full h-72 sm:h-80 object-cover object-center group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/40 to-transparent"></div>
              
              <div class="absolute bottom-4 left-4 right-4">
                <div class="p-3 rounded-xl bg-slate-900/90 backdrop-blur-md border border-cyan-500/30 flex items-center justify-between">
                  <div>
                    <span class="text-[10px] font-mono-tech text-cyan-400 block uppercase font-bold">Empirical Classroom Deployment</span>
                    <span class="text-xs text-white font-medium">Cycle I & II Practice in SMAN 15 Bandung Computer Lab</span>
                  </div>
                  <a
                    href={algocraft.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="p-2 rounded-lg bg-cyan-500 text-slate-950 hover:bg-cyan-400 transition-colors"
                    aria-label="Visit AlgoCraft"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          </div>

        </div>
      </section>
    )}

    <!-- ACADEMIC DOSSIER SECTION LK 4: INNOVATIVE DESIGN FORMULATION -->
    <section id="dossier-lk4" class="scroll-mt-24 space-y-8">
      <div class="tech-card p-6 sm:p-10 relative overflow-hidden border border-amber-500/30 bg-slate-950/80">
        
        <!-- Ambient glow -->
        <div class="absolute top-0 right-0 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none -mr-20 -mt-20"></div>

        <!-- Header LK 4 -->
        <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-6 pb-6 border-b border-slate-800 relative z-10">
          <div class="space-y-3 flex-1 min-w-0">
            <!-- Badges Bar -->
            <div class="flex items-center gap-2.5 flex-wrap">
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-mono-tech font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30 whitespace-nowrap">
                PHASE 5 • PPG SEMINAR
              </span>
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono-tech font-bold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30 whitespace-nowrap shadow-sm">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                Empirically Verified (+38.21 Pts)
              </span>
              <span class="text-xs font-mono-tech text-slate-400 hidden sm:inline whitespace-nowrap">
                • Official Worksheet 4: Innovative Design
              </span>
            </div>

            <!-- Title -->
            <h3 class="text-xl sm:text-2xl lg:text-3xl font-extrabold text-white tracking-tight leading-snug">
              {lk4.judulEn || lk4.judul}
            </h3>

            <!-- Metadata -->
            <p class="text-xs sm:text-sm text-slate-300 font-mono-tech leading-relaxed">
              <span class="text-cyan-400 font-bold">Design Output:</span> AlgoCraft (PBL-Based Gamified Web) <span class="text-slate-600 mx-1">•</span> <span class="text-slate-400">Target: {lk4.identitas.sasaran}</span>
            </p>
          </div>

          <!-- Action Button -->
          <div class="flex items-center gap-3 shrink-0 self-start lg:self-center">
            <a
              href="/Artefak PPG/05_Semester_2/07_Seminar_PPG/05_LK_4_Desain_Karya_Inovatif_AlgoCraft/LEMBAR KERJA 4 (LK 4) - Desain Karya Inovatif AlgoCraft.docx"
              target="_blank"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-700 hover:border-amber-500/40 text-amber-300 font-mono-tech text-xs font-semibold transition-all whitespace-nowrap shadow-sm hover:bg-slate-850"
            >
              <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
              <span>Worksheet 4 (.docx)</span>
            </a>
          </div>
        </div>

        <div class="space-y-10 pt-8">
          
          <!-- 1. Needs Identification & Pre-Action Hurdles -->
          <div class="space-y-4">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-rose-400"></span>
              <h4 class="text-lg font-bold text-white tracking-tight">
                1. Needs & Challenge Identification (Class X-5 Baseline Findings)
              </h4>
            </div>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed text-justify">
              Initial diagnostic assessment of 46 students in Class X-5 revealed an average baseline score of only 39.86 (out of mastery standard KKTP 75). Only 5 students (10.87%) passed, while 41 students (89.13%) had not yet met competency criteria.
            </p>

            <!-- Grid 6 Initial Indicators -->
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 pt-1">
              {lk4.identifikasiTantangan.temuanPraTindakan.skorIndikatorAwal.map(item => (
                <div class="p-3 rounded-xl bg-slate-900/90 border border-slate-800 text-center flex flex-col justify-between">
                  <span class="text-[11px] font-mono-tech text-slate-400 block line-clamp-2 leading-tight mb-2 h-7 flex items-center justify-center">{item.indikator}</span>
                  <div>
                    <span class="text-sm font-bold text-rose-400 block">{item.skor}</span>
                    <span class="text-[10px] font-mono-tech text-slate-500 block mt-0.5">{item.persen}</span>
                  </div>
                </div>
              ))}
            </div>

            <div class="p-4 rounded-xl bg-rose-950/30 border border-rose-500/20 text-xs text-slate-300 leading-relaxed">
              <strong>Initial Learner Autonomy:</strong> Average autonomy rating stood at 2.14 / 4.00, with 91.30% in 'Less Autonomous' category due to passive reliance on teacher direct demonstration.
            </div>

            <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 space-y-2">
              <strong class="text-xs font-mono-tech text-amber-300 block uppercase">
                Cycle I Reflection Hurdles (Large Classroom Constraints):
              </strong>
              <ul class="space-y-1 text-xs text-slate-300 list-disc list-inside">
                {lk4.identifikasiTantangan.refleksiSiklusI.poin.map(p => (
                  <li>{p}</li>
                ))}
              </ul>
            </div>
          </div>

          <!-- 2. 5 Principles of Educational Innovation -->
          <div class="space-y-4 pt-4 border-t border-slate-800">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-cyan-400"></span>
              <h4 class="text-lg font-bold text-white tracking-tight">
                2. Fulfillment of 5 Principles of Educational Innovation (LK 4 Framework)
              </h4>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 pt-1">
              {lk4.perumusanGagasanDanTujuan.prinsipInovasi.map(p => (
                <div class="p-5 rounded-2xl bg-slate-900/70 border border-slate-800 flex flex-col justify-between group hover:border-cyan-500/30 transition-all">
                  <div>
                    <h5 class="text-sm font-bold text-cyan-300 mb-2 flex items-center gap-2">
                      <span class="text-xs">✨</span>
                      <span>{p.prinsip}</span>
                    </h5>
                    <p class="text-xs text-slate-300 leading-relaxed text-justify">
                      {p.deskripsi}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- 3. AlgoCraft Modular Architecture & Comparative Research -->
          <div class="space-y-4 pt-4 border-t border-slate-800">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-purple-400"></span>
              <h4 class="text-lg font-bold text-white tracking-tight">
                3. AlgoCraft Gamified Web Architecture & Comparative Research
              </h4>
            </div>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed text-justify bg-slate-900/60 p-4 rounded-xl border border-slate-800">
              <strong class="text-white block mb-1">Comparative Literature:</strong>
              {lk4.kajianRisetDanPrototipe.risetKomparatif}
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-1">
              {lk4.kajianRisetDanPrototipe.komponenAlgoCraft.map(k => (
                <div class="p-4 rounded-xl bg-slate-900/70 border border-slate-800">
                  <h5 class="text-sm font-bold text-white mb-1 flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-purple-400"></span>
                    <span>{k.modul}</span>
                  </h5>
                  <p class="text-xs text-slate-300 leading-relaxed">
                    {k.fitur}
                  </p>
                </div>
              ))}
            </div>
          </div>

          <!-- 4. 80-Minute Classroom PBL Syntax -->
          <div class="space-y-4 pt-4 border-t border-slate-800">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
              <h4 class="text-lg font-bold text-white tracking-tight">
                4. 80-Minute Problem-Based Learning Syntax in Computer Lab
              </h4>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
              {lk4.implementasiDanSintaks.sintaksPBL80Menit.map((s, idx) => (
                <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800">
                  <span class="text-[10px] font-mono-tech text-emerald-400 block font-bold mb-1">
                    Phase {idx + 1}: {s.fase}
                  </span>
                  <p class="text-xs text-slate-300 leading-relaxed">
                    {s.aktivitas}
                  </p>
                </div>
              ))}
            </div>
          </div>

          <!-- 5. Empirical Action Research Results (+38.21 Points) -->
          <div class="space-y-4 pt-4 border-t border-slate-800">
            <div class="flex items-center justify-between gap-4 flex-wrap">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
                <h4 class="text-lg font-bold text-white tracking-tight">
                  5. Empirical Action Research Gains (Paired Data N=41 Students)
                </h4>
              </div>
              <span class="inline-flex items-center gap-1.5 text-xs font-mono-tech text-emerald-400 bg-emerald-500/10 px-3 py-1 rounded-full border border-emerald-500/30 whitespace-nowrap shrink-0 font-bold">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                Statistically Significant (Pre vs Post Cycle I)
              </span>
            </div>

            <div class="overflow-x-auto rounded-xl border border-slate-800">
              <table class="w-full text-xs text-left border-collapse font-mono-tech">
                <thead>
                  <tr class="bg-slate-900/90 text-slate-300 border-b border-slate-800">
                    <th class="p-3">Competency Metric</th>
                    <th class="p-3 text-center text-rose-300">Pre-Action</th>
                    <th class="p-3 text-center text-emerald-300">Post-Action (Cycle I)</th>
                    <th class="p-3 text-center text-cyan-300 font-bold">Gain (Delta)</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-800/60 text-slate-300">
                  {lk4.hasilEvaluasiEmpiris.metrik.map(m => (
                    <tr class="hover:bg-slate-900/40 transition-colors">
                      <td class="p-3 font-semibold text-white">{m.nama}</td>
                      <td class="p-3 text-center text-rose-400 font-bold">{m.pra}</td>
                      <td class="p-3 text-center text-emerald-400 font-bold">{m.pasca}</td>
                      <td class="p-3 text-center text-cyan-300 font-bold bg-cyan-950/20">{m.delta}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- OTHER INNOVATIONS GRID -->
    <div class="space-y-8">
      <div class="border-b border-slate-800 pb-4">
        <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
          Technology Innovations, Research & Pedagogy
        </h3>
        <p class="text-xs sm:text-sm text-slate-400 mt-1">
          Applied IoT engineering, classroom action research outputs, and differentiated pedagogical kits.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 sm:gap-8">
        {otherInovasi.map((item) => (
          <div class="tech-card p-6 flex flex-col justify-between group relative overflow-hidden border border-slate-800 hover:border-slate-700">
            
            <div>
              <!-- Image Banner -->
              <div class="relative h-48 rounded-xl overflow-hidden mb-5 border border-slate-800 bg-slate-950">
                <img
                  src={item.image}
                  alt={item.titleEn || item.title}
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
                <span class={`absolute top-3 left-3 text-[10px] font-mono-tech font-bold uppercase px-2.5 py-1 rounded-md border ${item.badgeColor}`}>
                  {item.categoryEn || item.category}
                </span>
              </div>

              <!-- Title & Highlight -->
              <div class="mb-3">
                <span class="text-xs font-mono-tech text-amber-400 block mb-1">
                  ⭐ {item.highlightEn || item.highlight}
                </span>
                <h4 class="text-lg font-bold text-white group-hover:text-cyan-300 transition-colors leading-snug">
                  {item.titleEn || item.title}
                </h4>
              </div>

              <!-- Description -->
              <p class="text-xs sm:text-sm text-slate-300 leading-relaxed text-justify line-clamp-4 mb-4">
                {item.deskripsiEn || item.deskripsi}
              </p>

              <!-- Stats Highlights -->
              <div class="grid grid-cols-2 gap-2 mb-4">
                {(item.statsEn || item.stats).slice(0, 2).map(s => (
                  <div class="p-2 rounded-lg bg-slate-950/70 border border-slate-800/80">
                    <span class="text-[9px] font-mono-tech uppercase text-slate-400 block">{s.label}</span>
                    <span class="text-xs font-bold text-slate-200 block truncate">{s.value}</span>
                  </div>
                ))}
              </div>

              <!-- Tech Badges -->
              <div class="flex flex-wrap gap-1 mb-5">
                {item.techStack.map(t => (
                  <span class="text-[10px] font-mono-tech px-2 py-0.5 rounded bg-slate-900 border border-slate-800 text-slate-400">
                    {t}
                  </span>
                ))}
              </div>
            </div>

            <!-- Featured Documents / Links -->
            <div class="pt-4 border-t border-slate-800/80 space-y-2">
              <span class="text-[10px] font-mono-tech uppercase text-slate-400 block font-bold">
                Authentic Artifact Documents:
              </span>
              <div class="space-y-1.5">
                {item.featuredArtifacts.map(doc => (
                  <a
                    href={doc.url}
                    target="_blank"
                    class="flex items-center justify-between text-xs text-cyan-400 hover:text-cyan-300 p-2 rounded-lg bg-slate-900/60 hover:bg-slate-900 border border-slate-800 transition-colors group/link"
                  >
                    <span class="truncate pr-2 font-medium">{doc.name}</span>
                    <svg class="w-3.5 h-3.5 shrink-0 opacity-70 group-hover/link:opacity-100 group-hover/link:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                    </svg>
                  </a>
                ))}
              </div>
            </div>

          </div>
        ))}
      </div>
    </div>

  </div>

  <ArtifactViewerModal isEn={true} />
</Layout>
