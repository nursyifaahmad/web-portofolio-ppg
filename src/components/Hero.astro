---
import profil from '../data/profil.json';

interface Props {
  isEn?: boolean;
}

const { isEn = false } = Astro.props;
---

<section class="relative min-h-[90dvh] min-h-[90vh] flex items-center justify-center pt-24 pb-16 px-4 sm:px-6 lg:px-8 overflow-hidden">
  <!-- Interactive Canvas Particle Network Background -->
  <canvas id="hero-particle-canvas" class="absolute inset-0 w-full h-full pointer-events-none opacity-60"></canvas>
  
  <!-- Radial Glow Behind Content -->
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-gradient-to-tr from-cyan-600/20 via-blue-600/15 to-purple-600/20 rounded-full blur-3xl pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto w-full relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Left Column: Introduction & Typing Terminal -->
      <div class="lg:col-span-7 flex flex-col gap-5 text-left">
        
        <!-- Status & Identity Badges -->
        <div class="flex flex-wrap items-center gap-2">
          <span class="tech-badge">
            <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
            PPG Prajabatan 2026
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/25 font-mono-tech">
            Universitas Pendidikan Indonesia
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-purple-500/10 text-purple-300 border border-purple-500/25 font-mono-tech">
            Kelas INF A
          </span>
        </div>

        <!-- Main Title with Clamped Typography -->
        <div>
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-tight">
            E-Portofolio <br class="hidden sm:inline" />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-blue-500">
              Guru Informatika
            </span>
          </h1>
          <p class="mt-2 text-base sm:text-lg text-slate-300 font-medium">
            Dokumentasi Perjalanan, 427+ Artefak Pembelajaran, dan Refleksi Filosofis PPG Prajabatan UPI.
          </p>
        </div>

        <!-- Interactive Typing Terminal Box -->
        <div class="scanline rounded-2xl bg-slate-950/90 border border-cyan-500/30 p-4 sm:p-5 font-mono-tech shadow-2xl shadow-cyan-950/50 backdrop-blur-md">
          <!-- Terminal Header Dots -->
          <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-800 text-xs text-slate-400">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-rose-500/80 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
              <span class="ml-2 text-slate-400 text-[11px]">ahmad@syifaserver:~</span>
            </div>
            <span class="text-[10px] text-cyan-400/80">bash 5.2</span>
          </div>

          <!-- Typing Content -->
          <div class="space-y-2 text-xs sm:text-sm">
            <div class="flex items-start gap-2 text-slate-300">
              <span class="text-emerald-400 select-none">$</span>
              <span class="text-cyan-300 font-semibold">whoami</span>
            </div>
            <div class="pl-4 text-slate-300">
              <strong class="text-white">{profil.nama}, {profil.gelar}</strong> 
              <span class="text-slate-400">(NIM: {profil.nim})</span>
              <div class="text-xs text-slate-400 mt-0.5">Calon Guru Profesional Bidang Studi Informatika • PPL di {profil.sekolahPPL}</div>
            </div>

            <div class="flex items-start gap-2 text-slate-300 pt-1">
              <span class="text-emerald-400 select-none">$</span>
              <span class="text-cyan-300 font-semibold">cat visi-guru.json</span>
            </div>
            <div class="pl-4 text-amber-300/90 text-xs sm:text-sm leading-relaxed">
              &quot;Mewujudkan murid <span class="font-bold text-cyan-300 bg-cyan-950/60 px-1 py-0.5 rounded border border-cyan-500/30">PANDAI</span>: 
              Paham Teknologi, Akhlaq Mulia, Nalar Kritis, Disiplin, Adaptif, dan Inovatif.&quot;
            </div>
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <a
            href="#semester-1"
            class="px-5 py-3 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-semibold text-sm shadow-lg shadow-cyan-500/25 flex items-center gap-2 group transition-all duration-200"
          >
            <span>{isEn ? "Explore Artifacts" : "Jelajahi Artefak Kuliah"}</span>
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>

          <button
            id="hero-open-cli-btn"
            type="button"
            class="px-4 py-3 rounded-xl border border-cyan-500/40 bg-slate-900/80 hover:bg-slate-800 text-cyan-300 font-mono-tech text-sm font-semibold flex items-center gap-2 transition-all cursor-pointer"
          >
            <span class="text-emerald-400">&gt;_</span>
            <span>{isEn ? "Open CLI Terminal" : "Buka Terminal CLI"}</span>
          </button>

          <a
            href="/profil"
            class="px-4 py-3 rounded-xl border border-slate-700 hover:border-slate-500 text-slate-300 hover:text-white text-sm font-medium transition-all"
          >
            {isEn ? "Profile & Mentors" : "Profil & Pembimbing"}
          </a>
        </div>

      </div>

      <!-- Right Column: Profile Identity Card -->
      <div class="lg:col-span-5 flex justify-center">
        <div class="w-full max-w-sm tech-card p-6 relative overflow-hidden group">
          <!-- Ambient Glow Border -->
          <div class="absolute -top-24 -right-24 w-48 h-48 bg-cyan-500/20 rounded-full blur-2xl group-hover:bg-cyan-500/30 transition-all"></div>
          
          <div class="flex flex-col items-center text-center relative z-10">
            <!-- Profile Photo with Glowing Double Ring -->
            <div class="relative mb-4">
              <div class="absolute -inset-1 rounded-2xl bg-gradient-to-r from-cyan-500 to-blue-600 opacity-75 blur-sm group-hover:opacity-100 transition-opacity"></div>
              <img
                src={profil.foto}
                alt={profil.nama}
                class="relative w-36 h-48 sm:w-40 sm:h-52 object-cover rounded-2xl border-2 border-cyan-400 shadow-2xl"
                loading="eager"
              />
              <div class="absolute bottom-2 right-2 px-2 py-0.5 rounded-md bg-slate-950/90 border border-emerald-400/50 text-[10px] font-mono-tech text-emerald-300 font-semibold flex items-center gap-1 shadow-md">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                VERIFIED
              </div>
            </div>

            <h2 class="text-xl font-bold text-white tracking-tight">{profil.nama}, {profil.gelar}</h2>
            <p class="text-xs text-cyan-400 font-mono-tech mt-0.5">NIM. {profil.nim}</p>
            <p class="text-xs text-slate-400 mt-1">{profil.kampus}</p>

            <div class="w-full my-4 border-t border-slate-800"></div>

            <!-- Mentors & School Info Grid -->
            <div class="w-full text-left space-y-2 text-xs">
              <div class="p-2 rounded-lg bg-slate-900/60 border border-slate-800 flex flex-col">
                <span class="text-[10px] uppercase font-mono-tech text-slate-500 font-semibold">Sekolah Mitra PPL</span>
                <span class="text-slate-200 font-medium">{profil.sekolahPPL}</span>
              </div>

              <div class="p-2 rounded-lg bg-slate-900/60 border border-slate-800 flex flex-col">
                <span class="text-[10px] uppercase font-mono-tech text-slate-500 font-semibold">Guru Pamong</span>
                <span class="text-slate-200 font-medium">{profil.guruPamong}</span>
              </div>

              <div class="p-2 rounded-lg bg-slate-900/60 border border-slate-800 flex flex-col">
                <span class="text-[10px] uppercase font-mono-tech text-slate-500 font-semibold">Dosen Pembimbing Lapangan (DPL)</span>
                <span class="text-slate-200 font-medium">{profil.dosenPembimbing}</span>
              </div>
            </div>

            <!-- Cloudflare Hostname Indicator -->
            <div class="mt-4 pt-3 w-full border-t border-slate-800/80 flex items-center justify-between text-[11px] text-slate-400 font-mono-tech">
              <span>Domain Host</span>
              <span class="text-emerald-400 flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                {profil.domain}
              </span>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Canvas Particle Animation Script -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const canvas = document.getElementById('hero-particle-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = canvas.width = canvas.parentElement.offsetWidth;
    let height = canvas.height = canvas.parentElement.offsetHeight;

    window.addEventListener('resize', () => {
      width = canvas.width = canvas.parentElement.offsetWidth;
      height = canvas.height = canvas.parentElement.offsetHeight;
    });

    // Particle count adapts to screen width to keep mobile smooth
    const isMobile = window.innerWidth < 768;
    const particleCount = isMobile ? 30 : 65;

    const particles = [];
    for (let i = 0; i < particleCount; i++) {
      particles.push({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.6,
        vy: (Math.random() - 0.5) * 0.6,
        radius: Math.random() * 2 + 1
      });
    }

    let animationFrameId;

    function render() {
      ctx.clearRect(0, 0, width, height);

      // Draw connection lines
      for (let i = 0; i < particles.length; i++) {
        for (let j = i + 1; j < particles.length; j++) {
          const dx = particles[i].x - particles[j].x;
          const dy = particles[i].y - particles[j].y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          const maxDist = isMobile ? 80 : 120;

          if (dist < maxDist) {
            ctx.beginPath();
            ctx.strokeStyle = `rgba(6, 182, 212, ${0.15 * (1 - dist / maxDist)})`;
            ctx.lineWidth = 0.8;
            ctx.moveTo(particles[i].x, particles[i].y);
            ctx.lineTo(particles[j].x, particles[j].y);
            ctx.stroke();
          }
        }
      }

      // Draw particles
      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        p.x += p.vx;
        p.y += p.vy;

        if (p.x < 0 || p.x > width) p.vx *= -1;
        if (p.y < 0 || p.y > height) p.vy *= -1;

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(56, 189, 248, 0.4)';
        ctx.fill();
      }

      animationFrameId = requestAnimationFrame(render);
    }

    render();

    // Trigger terminal from Hero button
    const heroCliBtn = document.getElementById('hero-open-cli-btn');
    if (heroCliBtn) {
      heroCliBtn.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('open-terminal'));
      });
    }
  });
</script>
