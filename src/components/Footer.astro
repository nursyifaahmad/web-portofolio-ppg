---
import profil from '../data/profil.json';

interface Props {
  isEn?: boolean;
}

const { isEn = false } = Astro.props;
---

<footer class="border-t border-cyan-500/20 bg-slate-950/95 py-12 px-4 sm:px-6 lg:px-8 pb-24 md:pb-12 text-slate-400 font-mono-tech text-xs">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
    
    <!-- Col 1: Identity & Degree -->
    <div class="md:col-span-2 space-y-3">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-cyan-500 to-blue-600 flex items-center justify-center text-white font-bold text-sm">
          &gt;_
        </div>
        <span class="text-base font-bold text-white">{profil.nama}, {profil.gelar}</span>
      </div>
      <p class="text-slate-300 text-xs leading-relaxed max-w-md font-sans">
        {isEn 
          ? "Interactive E-Portfolio of PPG Pre-Service Teacher in Informatics, Universitas Pendidikan Indonesia. Showcasing pedagogical competencies, technology-driven artifacts, and structured reflections."
          : "Website E-Portofolio Interaktif Calon Guru Profesional Bidang Studi Informatika, Universitas Pendidikan Indonesia. Menampilkan bukti karya, kompetensi pedagogis, dan refleksi bermakna."}
      </p>
      <div class="flex items-center gap-2 text-[11px] text-cyan-400">
        <span>NIM: {profil.nim}</span>
        <span>•</span>
        <span>Kelas INF A</span>
        <span>•</span>
        <span>LPTK UPI Bandung</span>
      </div>
    </div>

    <!-- Col 2: Mentors & School -->
    <div class="space-y-2">
      <h4 class="text-slate-200 font-bold uppercase tracking-wider text-xs">
        {isEn ? "Mentorship" : "Pembimbing & Mitra"}
      </h4>
      <div class="space-y-2 text-xs">
        <div>
          <span class="text-slate-500 block text-[10px]">Guru Pamong:</span>
          <span class="text-slate-200">{profil.guruPamong}</span>
        </div>
        <div>
          <span class="text-slate-500 block text-[10px]">Dosen Pembimbing (DPL):</span>
          <span class="text-slate-200">{profil.dosenPembimbing}</span>
        </div>
        <div>
          <span class="text-slate-500 block text-[10px]">Sekolah Praktik:</span>
          <span class="text-slate-200">{profil.sekolahPPL}</span>
        </div>
      </div>
    </div>

    <!-- Col 3: System & Server -->
    <div class="space-y-2">
      <h4 class="text-slate-200 font-bold uppercase tracking-wider text-xs">
        {isEn ? "Infrastructure" : "Infrastruktur"}
      </h4>
      <div class="space-y-1.5 text-[11px]">
        <div class="flex items-center justify-between">
          <span class="text-slate-500">Domain:</span>
          <span class="text-emerald-400 font-bold">{profil.domain}</span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-slate-500">Host:</span>
          <span>syifaserver (Ubuntu Linux)</span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-slate-500">Container:</span>
          <span>Docker + Nginx Alpine</span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-slate-500">Tunnel:</span>
          <span>Cloudflare Zero Trust</span>
        </div>
      </div>
    </div>

  </div>

  <div class="max-w-7xl mx-auto pt-6 border-t border-slate-900 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div>
      © 2026 {profil.nama} • PPG Prajabatan Informatika Universitas Pendidikan Indonesia
    </div>
    <div class="flex items-center gap-3">
      <button
        onclick="window.dispatchEvent(new CustomEvent('open-terminal'))"
        class="text-cyan-400 hover:text-cyan-300 underline cursor-pointer"
      >
        Terminal CLI (&gt;_)
      </button>
      <span>•</span>
      <a href={isEn ? "/en/artefak" : "/artefak"} class="hover:text-cyan-400">
        {isEn ? "1,000 Artifacts" : "1.000 Artefak"}
      </a>
      <span>•</span>
      <a href="#top" class="hover:text-white">
        ↑ Ke Atas
      </a>
    </div>
  </div>
</footer>
