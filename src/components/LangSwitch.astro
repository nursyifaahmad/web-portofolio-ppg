---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
const currentPath = Astro.url.pathname;
const isEn = currentPath.startsWith('/en');

// Construct corresponding target path
let targetPath = isEn 
  ? currentPath.replace(/^\/en/, '') || '/'
  : `/en${currentPath === '/' ? '' : currentPath}`;
---

<a
  href={targetPath}
  aria-label={isEn ? "Ganti ke Bahasa Indonesia" : "Switch to English"}
  class={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-cyan-500/20 bg-slate-900/60 hover:bg-slate-800/80 text-xs font-semibold tracking-wider font-mono-tech transition-all duration-200 ${className}`}
>
  <span class={!isEn ? "text-cyan-400 font-bold" : "text-slate-400 hover:text-slate-200"}>ID</span>
  <span class="text-slate-600">/</span>
  <span class={isEn ? "text-cyan-400 font-bold" : "text-slate-400 hover:text-slate-200"}>EN</span>
</a>
