---
interface Props {
  isEn?: boolean;
}

const { isEn = false } = Astro.props;
const prefix = isEn ? '/en' : '';
---

<nav class="md:hidden fixed bottom-0 left-0 right-0 z-30 bg-slate-950/90 backdrop-blur-lg border-t border-cyan-500/20 px-3 py-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] transition-all duration-200">
  <div class="grid grid-cols-5 gap-1 items-center max-w-md mx-auto text-center">
    
    <a href={`${prefix}/`} class="flex flex-col items-center justify-center p-1 rounded-xl text-slate-400 hover:text-cyan-400 hover:bg-slate-900 transition-colors">
      <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
      </svg>
      <span class="text-[9px] font-medium leading-none">{isEn ? "Home" : "Beranda"}</span>
    </a>

    <a href={`${prefix}/profil`} class="flex flex-col items-center justify-center p-1 rounded-xl text-slate-400 hover:text-cyan-400 hover:bg-slate-900 transition-colors">
      <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
      </svg>
      <span class="text-[9px] font-medium leading-none">{isEn ? "Profile" : "Profil"}</span>
    </a>

    <a href={`${prefix}/artefak`} class="flex flex-col items-center justify-center p-1 rounded-xl text-slate-400 hover:text-cyan-400 hover:bg-slate-900 transition-colors">
      <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 19a2 2 0 01-2-2V7a2 2 0 012-2h4l2 2h4a2 2 0 012 2v1M5 19h14a2 2 0 002-2v-5a2 2 0 00-2-2H9a2 2 0 00-2 2v5a2 2 0 01-2 2z"></path>
      </svg>
      <span class="text-[9px] font-medium leading-none">{isEn ? "Artifacts" : "Artefak"}</span>
    </a>

    <a href={`${prefix}/refleksi`} class="flex flex-col items-center justify-center p-1 rounded-xl text-slate-400 hover:text-cyan-400 hover:bg-slate-900 transition-colors">
      <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
      </svg>
      <span class="text-[9px] font-medium leading-none">{isEn ? "Reflection" : "Refleksi"}</span>
    </a>

    <a href={`${prefix}/inovasi`} class="flex flex-col items-center justify-center p-1 rounded-xl text-slate-400 hover:text-cyan-400 hover:bg-slate-900 transition-colors relative">
      <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
      </svg>
      <span class="text-[9px] font-medium leading-none">{isEn ? "Innovation" : "Inovasi"}</span>
      <span class="absolute top-1 right-2 w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
    </a>

  </div>
</nav>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const bottomCli = document.getElementById('bottom-nav-terminal-btn');
    if (bottomCli) {
      bottomCli.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('open-terminal'));
      });
    }
  });
</script>
