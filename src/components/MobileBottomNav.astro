---
interface Props {
  isEn?: boolean;
}

const { isEn = false } = Astro.props;
const prefix = isEn ? '/en' : '';
---

<nav class="md:hidden fixed bottom-0 left-0 right-0 z-30 bg-slate-950/90 backdrop-blur-lg border-t border-cyan-500/20 px-3 py-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] transition-all duration-200">
  <div class="grid grid-cols-5 gap-1 items-center max-w-md mx-auto text-center">
    
    <a href={`${prefix}/`} class="flex flex-col items-center justify-center p-1.5 rounded-xl text-slate-400 hover:text-cyan-400 hover:bg-slate-900 transition-colors">
      <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
      </svg>
      <span class="text-[10px] font-medium leading-none">{isEn ? "Home" : "Beranda"}</span>
    </a>

    <a href={`${prefix}/matkul`} class="flex flex-col items-center justify-center p-1.5 rounded-xl text-slate-400 hover:text-cyan-400 hover:bg-slate-900 transition-colors">
      <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
      </svg>
      <span class="text-[10px] font-medium leading-none">{isEn ? "Courses" : "Matkul"}</span>
    </a>

    <a href={`${prefix}/#timeline`} class="flex flex-col items-center justify-center p-1.5 rounded-xl text-slate-400 hover:text-cyan-400 hover:bg-slate-900 transition-colors">
      <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <span class="text-[10px] font-medium leading-none">{isEn ? "Timeline" : "Linimasa"}</span>
    </a>

    <a href={`${prefix}/galeri`} class="flex flex-col items-center justify-center p-1.5 rounded-xl text-slate-400 hover:text-cyan-400 hover:bg-slate-900 transition-colors">
      <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
      </svg>
      <span class="text-[10px] font-medium leading-none">{isEn ? "Gallery" : "Galeri"}</span>
    </a>

    <button
      id="bottom-nav-terminal-btn"
      type="button"
      class="flex flex-col items-center justify-center p-1.5 rounded-xl bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 hover:bg-cyan-500/30 transition-colors cursor-pointer"
    >
      <span class="font-mono-tech font-bold text-sm leading-tight">&gt;_</span>
      <span class="text-[10px] font-mono-tech font-bold leading-none">CLI</span>
    </button>

  </div>
</nav>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const bottomCli = document.getElementById('bottom-nav-terminal-btn');
    if (bottomCli) {
      bottomCli.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('open-terminal'));
      });
    }
  });
</script>
