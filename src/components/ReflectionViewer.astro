---
interface Props {
  refleksi: any;
  refleksi4C?: {
    connection?: string;
    challenge?: string;
    concept?: string;
    change?: string;
    artefak_terpilih?: string;
    alasan_artefak?: string;
    bagian_pendukung?: string;
    rumusan_refleksi?: string;
  };
  courseTitle?: string;
  docUrl?: string;
  isEn?: boolean;
}

const { refleksi, refleksi4C, courseTitle = "Mata Kuliah", docUrl, isEn = false } = Astro.props;

const connectionText = refleksi4C?.connection || refleksi?.facts || "";
const challengeText = refleksi4C?.challenge || refleksi?.feelings || "";
const conceptText = refleksi4C?.concept || refleksi?.findings || "";
const changeText = refleksi4C?.change || refleksi?.future || "";
const selectedArtifact = refleksi4C?.artefak_terpilih || "";
const artifactReason = refleksi4C?.alasan_artefak || "";
const supportingSection = refleksi4C?.bagian_pendukung || "";
const summaryReflection = refleksi4C?.rumusan_refleksi || "";

const pillars = [
  {
    key: 'Connection',
    title: isEn ? 'Connection' : '1. Connection (Keterkaitan)',
    question: isEn ? 'How does the material connect with my role as a future teacher?' : 'Apa keterkaitan materi perkuliahan dengan peran saya sebagai calon guru?',
    content: connectionText,
    icon: '🔗',
    badge: 'bg-cyan-500/10 text-cyan-300 border-cyan-500/30'
  },
  {
    key: 'Challenge',
    title: isEn ? 'Challenge' : '2. Challenge (Tantangan Paradigma)',
    question: isEn ? 'What new perspectives challenged my previous thoughts?' : 'Materi atau pandangan baru apa yang menantang pemikiran saya sebelumnya?',
    content: challengeText,
    icon: '⚡',
    badge: 'bg-amber-500/10 text-amber-300 border-amber-500/30'
  },
  {
    key: 'Concept',
    title: isEn ? 'Concept' : '3. Concept (Konsep Utama)',
    question: isEn ? 'What core concepts did I master as a professional educator?' : 'Apa saja konsep utama dan penting yang telah saya pelajari sebagai calon guru?',
    content: conceptText,
    icon: '💡',
    badge: 'bg-emerald-500/10 text-emerald-300 border-emerald-500/30'
  },
  {
    key: 'Change',
    title: isEn ? 'Change' : '4. Change (Aksi Perubahan)',
    question: isEn ? 'What practical changes will I implement in teaching?' : 'Apa saja perubahan yang ingin saya lakukan setelah mendapatkan materi perkuliahan ini?',
    content: changeText,
    icon: '🚀',
    badge: 'bg-purple-500/10 text-purple-300 border-purple-500/30'
  }
];
---

<div class="tech-card p-6 sm:p-8 relative overflow-hidden space-y-8">
  
  <!-- Header Refleksi -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="tech-badge">
          {isEn ? "Authentic 4C Framework" : "Model Refleksi 4C Resmi PPG"}
        </span>
        <span class="text-xs font-mono-tech text-slate-400">
          Lembar Kerja 2 (LK 2)
        </span>
      </div>
      <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
        {isEn ? "Reflective Learning Practice" : "Refleksi Pengalaman Belajar & Transformasi Pendidik"}
      </h3>
    </div>

    {docUrl && (
      <a
        href={docUrl}
        download
        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-900 border border-slate-700 hover:border-cyan-500/40 text-cyan-300 font-mono-tech text-xs font-semibold transition-all self-start sm:self-auto shrink-0 shadow-sm"
      >
        <span>📄</span>
        <span>Unduh LK 2 Asli (.docx)</span>
      </a>
    )}
  </div>

  <!-- 4C Pillars Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-6">
    {pillars.map((p) => (
      <div class="p-5 sm:p-6 rounded-2xl bg-slate-950/70 border border-slate-800/80 hover:border-slate-700 transition-all flex flex-col justify-between group">
        <div>
          <div class="flex items-center justify-between gap-2 mb-2">
            <div class="flex items-center gap-2">
              <span class="text-2xl select-none">{p.icon}</span>
              <h4 class="text-base font-bold text-white group-hover:text-cyan-300 transition-colors">
                {p.title}
              </h4>
            </div>
            <span class={`text-[10px] font-mono-tech font-bold uppercase px-2 py-0.5 rounded border ${p.badge}`}>
              {p.key}
            </span>
          </div>

          <p class="text-xs font-mono-tech text-slate-400 mb-3 italic">
            "{p.question}"
          </p>

          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed whitespace-pre-line text-justify">
            {p.content}
          </p>
        </div>
      </div>
    ))}
  </div>

  <!-- Analisis Artefak Pembelajaran (Jika ada) -->
  {(selectedArtifact || artifactReason) && (
    <div class="p-5 sm:p-6 rounded-2xl bg-slate-900/60 border border-cyan-500/25 relative overflow-hidden">
      <div class="flex items-center gap-2 mb-4">
        <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
        <h4 class="text-sm font-bold text-cyan-300 uppercase tracking-wider font-mono-tech">
          Analisis Artefak Pembelajaran Terpilih
        </h4>
      </div>

      <div class="space-y-4 text-xs sm:text-sm text-slate-300 leading-relaxed">
        {selectedArtifact && (
          <div class="p-3.5 rounded-xl bg-slate-950/80 border border-slate-800">
            <strong class="text-white block font-mono-tech text-xs uppercase text-slate-400 mb-1">
              Artefak Bukti Dukung:
            </strong>
            <span class="text-cyan-300 font-semibold">{selectedArtifact}</span>
          </div>
        )}

        {artifactReason && (
          <div>
            <strong class="text-white block mb-1">Alasan Pemilihan Artefak:</strong>
            <p class="whitespace-pre-line text-justify">{artifactReason}</p>
          </div>
        )}

        {supportingSection && (
          <div>
            <strong class="text-white block mb-1">Bagian Artefak yang Mendukung Refleksi:</strong>
            <p class="whitespace-pre-line text-justify">{supportingSection}</p>
          </div>
        )}
      </div>
    </div>
  )}

  <!-- Rumusan Hasil Refleksi (Quote Pendidik) -->
  {summaryReflection && (
    <div class="p-6 rounded-2xl bg-gradient-to-br from-cyan-950/30 via-slate-900/80 to-slate-950 border border-cyan-500/30 relative">
      <div class="flex items-center gap-2 text-cyan-400 text-xs font-mono-tech font-bold uppercase mb-2">
        <span>💬</span>
        <span>Rumusan Refleksi Calon Guru Profesional</span>
      </div>
      <p class="text-xs sm:text-sm text-slate-200 leading-relaxed italic whitespace-pre-line text-justify">
        "{summaryReflection}"
      </p>
      <div class="mt-3 text-right">
        <span class="text-xs font-bold text-white">— Ahmad Nursyifa, S.Kom.</span>
      </div>
    </div>
  )}

</div>
