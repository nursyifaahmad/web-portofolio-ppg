---
import profil from '../data/profil.json';

interface Props {
  isEn?: boolean;
}

const { isEn = false } = Astro.props;
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
    
    <!-- Stat 1: Total Artefak -->
    <div class="tech-card p-5 relative overflow-hidden group">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-mono-tech uppercase text-cyan-400 font-semibold tracking-wider">
          {isEn ? "Curated Artifacts" : "Artefak Terkurasi"}
        </span>
        <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
      </div>
      <div class="text-3xl sm:text-4xl font-extrabold text-white font-mono-tech tracking-tight group-hover:text-cyan-400 transition-colors">
        {isEn ? "1,000+" : "1.000+"}
      </div>
      <p class="text-xs text-slate-400 mt-1">
        {isEn ? "100% Local Files (LK, Modules, PPT)" : "100% Berkas Lokal (LK, Modul, PPT)"}
      </p>
    </div>

    <!-- Stat 2: Mata Kuliah -->
    <div class="tech-card p-5 relative overflow-hidden group">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-mono-tech uppercase text-emerald-400 font-semibold tracking-wider">
          {isEn ? "Total Courses" : "Mata Kuliah"}
        </span>
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
      </div>
      <div class="text-3xl sm:text-4xl font-extrabold text-white font-mono-tech tracking-tight group-hover:text-emerald-400 transition-colors">
        16
      </div>
      <p class="text-xs text-slate-400 mt-1">
        {isEn ? "Pra-Semester, Sem 1 & Sem 2" : "Pra-Semester, SMT 1 & SMT 2"}
      </p>
    </div>

    <!-- Stat 3: Jam Mengajar PPL -->
    <div class="tech-card p-5 relative overflow-hidden group">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-mono-tech uppercase text-purple-400 font-semibold tracking-wider">
          {isEn ? "Teaching Hours" : "Praktik PPL"}
        </span>
        <span class="w-2 h-2 rounded-full bg-purple-400"></span>
      </div>
      <div class="text-3xl sm:text-4xl font-extrabold text-white font-mono-tech tracking-tight group-hover:text-purple-400 transition-colors">
        200+
      </div>
      <p class="text-xs text-slate-400 mt-1">
        {isEn ? "Classroom teaching at SMAN 15" : "Jam Mengajar di SMAN 15 Bandung"}
      </p>
    </div>

    <!-- Stat 4: Projek Kepemimpinan & Inovasi -->
    <div class="tech-card p-5 relative overflow-hidden group">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-mono-tech uppercase text-amber-400 font-semibold tracking-wider">
          {isEn ? "Innovation Project" : "Projek Kepemimpinan"}
        </span>
        <span class="w-2 h-2 rounded-full bg-amber-400"></span>
      </div>
      <div class="text-3xl sm:text-4xl font-extrabold text-white font-mono-tech tracking-tight group-hover:text-amber-400 transition-colors">
        SIDAKAN
      </div>
      <p class="text-xs text-slate-400 mt-1">
        {isEn ? "Smart IoT Sustainable System" : "Sistem IoT Cerdas Berkelanjutan"}
      </p>
    </div>

  </div>
</section>
